<% title "Your order" %>
<section class="md-section"><div class="md-section__inner md-stack">
  <div class="storefront-heading-row"><div><p class="md-section__eyebrow">Order <%= @order.public_reference %></p><h1><%= @order.state.titleize %></h1></div></div>

  <% if @order.simulated? %>
    <div class="storefront-simulation-banner" role="status"><strong>Preview simulation</strong><p>This order was completed through the local checkout simulator — no money moved.</p></div>
  <% end %>

  <div class="md-card md-card--outlined">
    <h2>Items</h2>
    <div class="md-list">
      <% @order.line_items.each do |item| %>
        <div class="md-list-item"><div><strong><%= item.name %></strong><br><span><%= item.quantity %> &times; <%= storefront_money(item.unit_price_cents, item.currency) %></span></div><strong><%= storefront_money(item.line_total_cents, item.currency) %></strong></div>
      <% end %>
      <div class="md-list-item"><div><span>Subtotal</span></div><strong><%= storefront_money(@order.subtotal_cents, @order.currency) %></strong></div>
      <div class="md-list-item"><div><span><%= Foundation::Storefront::Shipping.name_for(@order.shipping_method) %></span></div><strong><%= storefront_money(@order.shipping_cents, @order.currency) %></strong></div>
      <div class="md-list-item storefront-total"><div><strong>Total</strong></div><strong><%= storefront_money(@order.total_cents, @order.currency) %></strong></div>
    </div>
  </div>

  <div class="md-card md-card--outlined">
    <h2>Shipping to</h2>
    <p><%= @order.shipping_name %><br><%= @order.shipping_line1 %><%= "<br>#{@order.shipping_line2}".html_safe if @order.shipping_line2.present? %><br><%= [ @order.shipping_city, @order.shipping_region, @order.shipping_postal_code, @order.shipping_country ].compact_blank.join(", ") %></p>
  </div>

  <div class="md-card md-card--outlined">
    <h2>Order history</h2>
    <p>Want to see all your past orders? <%= link_to "Look up orders by email", storefront_order_lookup_path %>.</p>
  </div>

  <div class="md-actions">
    <%= link_to "Back to shop", storefront_products_path, class: "md-button md-button--outlined" %>
    <%= link_to "Look up past orders", storefront_order_lookup_path, class: "md-button md-button--text" %>
  </div>
</div></section>
